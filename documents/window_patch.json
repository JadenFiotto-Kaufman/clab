{
  "description": "The multi-position patch as ONE write: three content tokens of the counterfactual, -4/-3/-2, swapped into the base in a single window, {'index': [-4, -1]}. multi_position_patch.json is the same experiment as three writes at -4, -3, -2 — and the two produce the same logits to the bit, which is the test of what a window is.",
  "model": {
    "key": "hf-internal-testing/tiny-random-LlamaForCausalLM",
    "revision": "9fb191250dd56d0ba7ec9785a025ed29c03d5998",
    "dtype": "float32"
  },
  "data": {"pairs": {"path": "weekdays/train"}},
  "sites": {
    "target": {"component": "layer_output", "layers": 0},
    "head": {"component": "lm_head_output"}
  },
  "steps": {
    "counterfactual": {
      "kind": "forward",
      "input": "pairs.counterfactual_inputs[0]",
      "reads": {"v_cf": {"site": "target", "pos": {"index": [-4, -1]}}}
    },
    "patched": {
      "kind": "forward",
      "input": "pairs.input",
      "writes": {
        "patch": {
          "site": "target",
          "pos": {"index": [-4, -1]},
          "ops": [{"op": "swap", "with": "counterfactual.v_cf"}]
        }
      },
      "reads": {"logits": {"site": "head", "pos": -1}}
    },
    "logit_diff": {
      "kind": "op",
      "op": "logit_diff",
      "of": "patched.logits",
      "a": "pairs.cf_answer",
      "b": "pairs.base_answer"
    }
  },
  "saves": ["logit_diff"]
}
