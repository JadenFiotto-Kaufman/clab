{
  "description": "Two experiments at one site over the same rows, and the baseline they share. `interventions` declares interchange patching and mean ablation at the last position of layer 0; nothing there runs until a step lists it. `clean` runs the un-intervened model, scores it, and reads the activation `mean` averages. `patched` lists `patching`, whose operand is `counterfactual.v_cf`; `ablated` lists `ablation`, whose operand is `mean`, the step before it. Each metric is a step with its own name, `patching_ld` and `ablation_ld`, so the two experiments' results sit side by side in one output directory and `plan.table(\"patching_ld\", \"ablation_ld\")` joins them row by row. Tiny CPU Llama, so the numbers demonstrate the mechanism and nothing else.",
  "model": {
    "key": "hf-internal-testing/tiny-random-LlamaForCausalLM",
    "revision": "9fb191250dd56d0ba7ec9785a025ed29c03d5998",
    "dtype": "float32"
  },
  "data": {"pairs": {"path": "weekdays/train"}},
  "sites": {
    "target": {"component": "layer_output", "layers": 0},
    "head": {"component": "lm_head_output"}
  },
  "interventions": {
    "patching": {
      "patch": {"site": "target", "pos": -1, "ops": [{"op": "swap", "with": "counterfactual.v_cf"}]},
      "logits": {"site": "head", "pos": -1}
    },
    "ablation": {
      "ablate": {"site": "target", "pos": -1, "ops": [{"op": "swap", "with": "mean"}]},
      "logits": {"site": "head", "pos": -1}
    }
  },
  "steps": {
    "clean": {
      "kind": "forward",
      "input": "pairs.input",
      "interventions": {"acts": {"site": "target", "pos": -1}, "logits": {"site": "head", "pos": -1}}
    },
    "clean_ld": {
      "kind": "op",
      "op": "logit_diff",
      "of": "clean.logits",
      "a": "pairs.cf_answer",
      "b": "pairs.base_answer"
    },
    "mean": {"kind": "op", "op": "mean", "of": "clean.acts"},
    "counterfactual": {
      "kind": "forward",
      "input": "pairs.counterfactual_inputs[0]",
      "interventions": {"v_cf": {"site": "target", "pos": -1}}
    },
    "patched": {"kind": "forward", "input": "pairs.input", "interventions": "patching"},
    "iia": {"kind": "op", "op": "match", "of": "patched.logits", "expected": "pairs.cf_answer"},
    "patching_ld": {
      "kind": "op",
      "op": "logit_diff",
      "of": "patched.logits",
      "a": "pairs.cf_answer",
      "b": "pairs.base_answer"
    },
    "ablated": {"kind": "forward", "input": "pairs.input", "interventions": "ablation"},
    "ablation_ld": {
      "kind": "op",
      "op": "logit_diff",
      "of": "ablated.logits",
      "a": "pairs.cf_answer",
      "b": "pairs.base_answer"
    }
  },
  "saves": ["clean_ld", "iia", "patching_ld", "ablation_ld"]
}
