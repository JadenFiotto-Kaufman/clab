{
  "description": "The hydra effect (McGrath et al. 2023, arXiv:2307.15771) on the tiny Llama: resample-ablate layer 0's attention at the final token, then measure each downstream layer's direct effect by injecting that layer's attention output as the final residual and reading the head. Reads taken inside one intervened forward are the operands of writes in another — `ablated.a1` is layer 1's attention *under the ablation* — which is a chain of calls, each step naming the one before.",
  "model": {
    "key": "hf-internal-testing/tiny-random-LlamaForCausalLM",
    "revision": "9fb191250dd56d0ba7ec9785a025ed29c03d5998",
    "dtype": "fp32"
  },
  "data": {"sample": {"path": "pile/data/sample"}},
  "sites": {
    "abl": {"component": "attention_output", "layers": 0},
    "probe0": {"component": "attention_output", "layers": 0},
    "probe1": {"component": "attention_output", "layers": 1},
    "resid_final": {"component": "layer_output", "layers": 1},
    "head": {"component": "lm_head_output"}
  },
  "steps": {
    "noise": {
      "kind": "forward",
      "input": "sample.resample_input",
      "reads": {"v_noise": {"site": "abl", "pos": -1}}
    },
    "clean": {
      "kind": "forward",
      "input": "sample.input",
      "reads": {
        "logits": {"site": "head", "pos": -1},
        "a0": {"site": "probe0", "pos": -1},
        "a1": {"site": "probe1", "pos": -1}
      }
    },
    "ablated": {
      "kind": "forward",
      "input": "sample.input",
      "writes": {"resample": {"site": "abl", "pos": -1, "ops": [{"op": "swap", "with": "noise.v_noise"}]}},
      "reads": {"logits": {"site": "head", "pos": -1}, "a1": {"site": "probe1", "pos": -1}}
    },
    "inj0_clean": {
      "kind": "forward",
      "input": "sample.input",
      "writes": {
        "inject": {"site": "resid_final", "pos": -1, "ops": [{"op": "swap", "with": "clean.a0"}]}
      },
      "reads": {"logits": {"site": "head", "pos": -1}}
    },
    "inj1_clean": {
      "kind": "forward",
      "input": "sample.input",
      "writes": {
        "inject": {"site": "resid_final", "pos": -1, "ops": [{"op": "swap", "with": "clean.a1"}]}
      },
      "reads": {"logits": {"site": "head", "pos": -1}}
    },
    "inj1_abl": {
      "kind": "forward",
      "input": "sample.input",
      "writes": {
        "inject": {"site": "resid_final", "pos": -1, "ops": [{"op": "swap", "with": "ablated.a1"}]}
      },
      "reads": {"logits": {"site": "head", "pos": -1}}
    },
    "te_clean": {"kind": "op", "op": "token_logit", "of": "clean.logits", "token": "sample.ml_token"},
    "te_abl": {"kind": "op", "op": "token_logit", "of": "ablated.logits", "token": "sample.ml_token"},
    "de0_c": {"kind": "op", "op": "token_logit", "of": "inj0_clean.logits", "token": "sample.ml_token"},
    "de1_c": {"kind": "op", "op": "token_logit", "of": "inj1_clean.logits", "token": "sample.ml_token"},
    "de1_a": {"kind": "op", "op": "token_logit", "of": "inj1_abl.logits", "token": "sample.ml_token"}
  },
  "saves": ["te_clean", "te_abl", "de0_c", "de1_c", "de1_a"]
}
