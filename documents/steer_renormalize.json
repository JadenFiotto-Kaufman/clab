{
  "description": "Steer, then put the norm back. `direction` is the mean of the residual stream over the counterfactual prompts; `steered` adds it, scaled by 4, at the last position (the `add` op), which also makes the activation longer. `steered_renormed` lists `restore` after `steer`, so both writes are in force on its one forward, and the renormalize, last at its site, rescales the result to the norm the activation had before either. 'Change the direction, keep the magnitude' — and `steered`, without the renormalize, is the comparison that shows how much of steering's effect was the longer vector. The three norms are saved, so the claim can be checked.",
  "model": {
    "key": "hf-internal-testing/tiny-random-LlamaForCausalLM",
    "revision": "9fb191250dd56d0ba7ec9785a025ed29c03d5998",
    "dtype": "float32"
  },
  "data": {"pairs": {"path": "weekdays/train"}},
  "sites": {
    "target": {"component": "layer_output", "layers": 0},
    "head": {"component": "lm_head_output"}
  },
  "interventions": {
    "steer": {"steer": {"site": "target", "pos": -1, "ops": [{"op": "add", "with": "direction", "scale": 4.0}]}},
    "restore": {"restore": {"site": "target", "pos": -1, "ops": [{"op": "renormalize"}]}}
  },
  "steps": {
    "harvest": {
      "kind": "forward",
      "input": "pairs.counterfactual_inputs[0]",
      "interventions": {"resid": {"site": "target", "pos": -1}}
    },
    "direction": {"kind": "op", "op": "mean", "of": "harvest.resid"},
    "base": {"kind": "forward", "input": "pairs.input", "interventions": {"resid": {"site": "target", "pos": -1}}},
    "steered": {
      "kind": "forward",
      "input": "pairs.input",
      "interventions": ["steer", {"logits": {"site": "head", "pos": -1}, "resid": {"site": "target", "pos": -1}}]
    },
    "steered_renormed": {
      "kind": "forward",
      "input": "pairs.input",
      "interventions": [
        "steer",
        "restore",
        {"logits": {"site": "head", "pos": -1}, "resid": {"site": "target", "pos": -1}}
      ]
    },
    "renormed_ld": {
      "kind": "op",
      "op": "logit_diff",
      "of": "steered_renormed.logits",
      "a": "pairs.cf_answer",
      "b": "pairs.base_answer"
    },
    "p_answer": {
      "kind": "op",
      "op": "token_prob",
      "of": "steered_renormed.logits",
      "token": "pairs.cf_answer"
    },
    "steered_ld": {
      "kind": "op",
      "op": "logit_diff",
      "of": "steered.logits",
      "a": "pairs.cf_answer",
      "b": "pairs.base_answer"
    }
  },
  "saves": ["renormed_ld", "steered_ld", "base.resid", "steered_renormed.resid", "steered.resid"]
}
