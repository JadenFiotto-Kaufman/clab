{
  "description": "The smallest real interchange: read the residual stream at the last token of the counterfactual prompt, swap it into the same place on the base prompt, and score what the model then says. Two forwards over the same pairs, and two metrics of the second: four steps. The head is a site written in place, because nothing else names it.",
  "model": {
    "key": "hf-internal-testing/tiny-random-LlamaForCausalLM",
    "revision": "9fb191250dd56d0ba7ec9785a025ed29c03d5998",
    "dtype": "float32"
  },
  "data": {"pairs": {"path": "weekdays/train"}},
  "sites": {"target": {"component": "layer_output", "layers": 0}},
  "steps": {
    "counterfactual": {
      "kind": "forward",
      "input": "pairs.counterfactual_inputs[0]",
      "interventions": {"v_cf": {"site": "target", "pos": -1}}
    },
    "patched": {
      "kind": "forward",
      "input": "pairs.input",
      "interventions": {
        "patch": {"site": "target", "pos": -1, "ops": [{"op": "swap", "with": "counterfactual.v_cf"}]},
        "logits": {"site": {"component": "lm_head_output"}, "pos": -1}
      }
    },
    "iia": {"kind": "op", "op": "match", "of": "patched.logits", "expected": "pairs.cf_answer"},
    "logit_diff": {
      "kind": "op",
      "op": "logit_diff",
      "of": "patched.logits",
      "a": "pairs.cf_answer",
      "b": "pairs.base_answer"
    }
  },
  "saves": ["iia", "logit_diff"]
}
