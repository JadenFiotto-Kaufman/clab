{
  "description": "The PCA control: the interchange DAS fits a rotation for, run through the top-4 principal directions of the residual stream instead — a basis loaded from what pca_harvest.json wrote, never trained. It keeps das_apply.json's name, `rot`, so the two documents differ only in what that featurizer is. What a trained rotation has to beat.",
  "model": {
    "key": "hf-internal-testing/tiny-random-LlamaForCausalLM",
    "revision": "9fb191250dd56d0ba7ec9785a025ed29c03d5998",
    "dtype": "fp32"
  },
  "data": {"test": {"path": "weekdays/data", "split": "test"}},
  "sites": {
    "target": {"component": "layer_output", "layers": 0},
    "head": {"component": "lm_head_output"}
  },
  "featurizers": {"rot": {"kind": "pca", "k": 4, "file_path": "documents/artifacts/basis.safetensors"}},
  "steps": {
    "counterfactual": {
      "kind": "forward",
      "input": "test.counterfactual_inputs[0]",
      "reads": {"v_cf": {"site": "target", "pos": -1, "ops": [{"op": "encode", "featurizer": "rot"}]}}
    },
    "patched": {
      "kind": "forward",
      "input": "test.input",
      "writes": {
        "patch": {
          "site": "target",
          "pos": -1,
          "ops": [{"op": "swap", "with": "counterfactual.v_cf", "featurizer": "rot"}]
        }
      },
      "reads": {"logits": {"site": "head", "pos": -1}}
    },
    "iia": {
      "kind": "op",
      "op": "logit_diff",
      "of": "patched.logits",
      "a": "test.cf_answer",
      "b": "test.base_answer"
    },
    "ce": {"kind": "op", "op": "cross_entropy", "of": "patched.logits", "target": "test.cf_answer"}
  },
  "saves": ["iia", "ce"]
}
