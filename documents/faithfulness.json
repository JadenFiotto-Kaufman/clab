{
  "description": "How much an interchange moves the whole prediction, not one logit: the patched run's next-token distribution scored against the clean run's on the same prompts. `kl` is KL(patched ‖ clean), in nats, weighted by where the patched model puts its mass; `js` is the symmetric Jensen–Shannon divergence, at most log 2. `p_answer` is the probability the patched run puts on the counterfactual answer — the soft accuracy, `match` without the argmax.",
  "model": {
    "key": "hf-internal-testing/tiny-random-LlamaForCausalLM",
    "revision": "9fb191250dd56d0ba7ec9785a025ed29c03d5998",
    "dtype": "fp32"
  },
  "data": {"pairs": {"path": "weekdays/train"}},
  "sites": {
    "target": {"component": "layer_output", "layers": 0},
    "head": {"component": "lm_head_output"}
  },
  "steps": {
    "clean": {
      "kind": "forward",
      "input": "pairs.input",
      "reads": {"logits": {"site": "head", "pos": -1}}
    },
    "counterfactual": {
      "kind": "forward",
      "input": "pairs.counterfactual_inputs[0]",
      "reads": {"v_cf": {"site": "target", "pos": -1}}
    },
    "patched": {
      "kind": "forward",
      "input": "pairs.input",
      "writes": {
        "patch": {"site": "target", "pos": -1, "ops": [{"op": "swap", "with": "counterfactual.v_cf"}]}
      },
      "reads": {"logits": {"site": "head", "pos": -1}}
    },
    "kl": {"kind": "op", "op": "kl", "of": "patched.logits", "against": "clean.logits"},
    "js": {"kind": "op", "op": "js", "of": "patched.logits", "against": "clean.logits"},
    "p_answer": {"kind": "op", "op": "token_prob", "of": "patched.logits", "token": "pairs.cf_answer"}
  },
  "saves": ["kl", "js", "p_answer"]
}
