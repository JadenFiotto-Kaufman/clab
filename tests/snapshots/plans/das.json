{
 "description": "DAS on the tiny CPU Llama. The fit's body is the experiment, run once per minibatch of up to 16 pairs (the training split has 2, so one minibatch an epoch): the counterfactual read through the rotation, and swapped into the base in its space. After training, the body runs once per named eval: `held_out`, with `test` in place of `train`, and `train`, on the pairs it trained on; `fit.held_out.iia` and `fit.train.iia` are the body's iia in each. `fit.rot` is the one name of the rotation — inside the body it is the rotation being trained, after it the trained one.",
 "model": {
  "key": "hf-internal-testing/tiny-random-LlamaForCausalLM",
  "revision": "9fb191250dd56d0ba7ec9785a025ed29c03d5998"
 },
 "data": {
  "train": {
   "path": "weekdays/data",
   "split": "train",
   "sha256": "77df26c6d38599f44538771836e186ade614dbb3b39879eca30031eb271b67a7",
   "n_rows": 2
  },
  "test": {
   "path": "weekdays/data",
   "split": "test",
   "sha256": "0ba4fcc8fb6b3cdce5ef2c459d9e9d0e16e55480910f26a4342e11b59dfe9d46",
   "n_rows": 2
  }
 },
 "featurizers": {
  "rot": {
   "kind": "subspace",
   "k": 8,
   "parametrization": "cayley"
  }
 },
 "steps": {
  "fit": {
   "kind": "fit",
   "train": [
    "rot"
   ],
   "objective": {
    "ce": 1.0
   },
   "epochs": 10,
   "batch_size": 16,
   "seed": 0,
   "optimizer": {
    "name": "adamw",
    "lr": 0.001
   },
   "steps": {
    "counterfactual": {
     "kind": "forward",
     "input": "train.counterfactual_inputs[0]",
     "interventions": {
      "v_cf": {
       "site": {
        "component": "layer_output",
        "layers": 0
       },
       "pos": -1,
       "ops": [
        {
         "op": "encode",
         "featurizer": "fit.rot"
        }
       ],
       "dims": [
        "rows",
        "pos",
        "features"
       ],
       "gathered": true
      }
     },
     "dataset": "train"
    },
    "patched": {
     "kind": "forward",
     "input": "train.input",
     "interventions": {
      "patch": {
       "site": {
        "component": "layer_output",
        "layers": 0
       },
       "pos": -1,
       "ops": [
        {
         "op": "encode",
         "featurizer": "fit.rot"
        },
        {
         "op": "swap",
         "with": "counterfactual.v_cf"
        },
        {
         "op": "decode",
         "featurizer": "fit.rot"
        }
       ],
       "dims": [
        "rows",
        "pos",
        "hidden_size"
       ]
      },
      "logits": {
       "site": {
        "component": "lm_head_output"
       },
       "pos": -1,
       "dims": [
        "rows",
        "pos",
        "vocab_size"
       ],
       "gathered": true
      }
     },
     "dataset": "train"
    },
    "iia": {
     "kind": "op",
     "op": "logit_diff",
     "of": "patched.logits",
     "dataset": "train",
     "dims": [
      "rows",
      "pos"
     ],
     "a": "train.cf_answer",
     "b": "train.base_answer"
    },
    "ce": {
     "kind": "op",
     "op": "cross_entropy",
     "of": "patched.logits",
     "dataset": "train",
     "dims": [
      "rows",
      "pos"
     ],
     "target": "train.cf_answer"
    }
   },
   "early_stop": {
    "metric": "iia",
    "mode": "max",
    "patience": 3
   },
   "eval": {
    "held_out": {
     "train": "test"
    },
    "train": {}
   }
  }
 },
 "saves": [
  "fit.held_out.iia",
  "fit.train.iia",
  "fit.train.ce",
  "fit.rot"
 ],
 "document": "documents/das.json",
 "compiled": true
}
